# Copy this file to .env and fill in the values.

# ---------------------------------------------------------------- Core
NODE_ENV=development
PORT=3000
APP_NAME=AI Assistance
# Public URL of this server. Meta and Telegram webhooks need it to be HTTPS and reachable
# from the internet (in development use a tunnel such as ngrok or cloudflared).
APP_URL=http://localhost:3000
# Dashboard URL. In development: the Vite dev server. In production leave it empty (= APP_URL).
WEB_URL=http://localhost:5173
# Long random string (32+ characters). Encrypts stored channel tokens: never change it after launch.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=
# PostgreSQL connection string. Leave empty to use the embedded database stored in DATA_DIR.
DATABASE_URL=
DATA_DIR=data
# Emails that get the super-admin console (/admin) to manage every business on the platform.
SUPERADMIN_EMAILS=
# false = invite-only: nobody can create an account on their own, you add each client in the admin console.
# (Emails listed in SUPERADMIN_EMAILS can still sign up, so you can create your own account.)
SIGNUPS_ENABLED=true
TRIAL_DAYS=14

# ---------------------------------------------------------------- AI provider
# groq      = free tier available. Get a key (no card needed) at https://console.groq.com/keys
# anthropic = Claude (paid). Better at long, careful conversations, tool use and Bangla/Banglish.
# Left empty, it picks groq when only GROQ_API_KEY is set, otherwise anthropic.
AI_PROVIDER=groq

# ---- Groq (also powers voice messages with Whisper, using the same key)
GROQ_API_KEY=
# Chat + tools. Alternatives: llama-3.3-70b-versatile, openai/gpt-oss-20b (faster, weaker).
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically when a customer sends a photo (the chat model is text-only).
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ---- Anthropic (Claude)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high — how much the model thinks before replying (latency vs. quality).
AI_EFFORT=medium
# Model for background work (image descriptions, website import, summaries). Defaults to AI_MODEL.
AI_BACKGROUND_MODEL=
# true = canned replies instead of Claude (to test channel setup without an API key).
AI_MOCK=false

# ---------------------------------------------------------------- Voice messages (speech-to-text)
# With GROQ_API_KEY set and the settings below left empty, voice messages use Groq's
# whisper-large-v3-turbo automatically. To use another provider (any OpenAI-compatible API):
#   OpenAI: STT_BASE_URL=https://api.openai.com/v1        STT_MODEL=whisper-1
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# ---------------------------------------------------------------- Meta: Messenger, Instagram, WhatsApp
# From your Meta app (developers.facebook.com). See docs/META_SETUP.md.
META_APP_ID=
META_APP_SECRET=
# Any random string; enter the same value in the App Dashboard webhook settings.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
# Facebook Login for Business configuration IDs (optional for Pages, required for WhatsApp).
META_LOGIN_CONFIG_ID=
META_WA_CONFIG_ID=

# ---------------------------------------------------------------- Email (reports and alerts)
# e.g. smtps://user:password@smtp.example.com:465 — empty prints emails to the console.
SMTP_URL=
MAIL_FROM=AI Assistance <no-reply@example.com>

# ---------------------------------------------------------------- Tuning
# Wait for the customer to finish typing before replying (they often send several messages).
REPLY_DEBOUNCE_MS=4000
REPLY_MAX_WAIT_MS=15000
WORKER_CONCURRENCY=10
